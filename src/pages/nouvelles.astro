  </div>

  <!-- Popup : liste complète des stations d'essence -->
  <dialog id="dialog-stations" class="rounded-xl p-0 max-w-md w-[90vw] backdrop:bg-black/60">
    <div class="bg-white">
      <header class="flex items-center justify-between px-5 py-3 border-b border-gray-200">
        <h3 class="font-extrabold text-gray-900">Stations d'essence — Abitibi-Ouest</h3>
        <button type="button" id="dialog-stations-close" aria-label="Fermer" class="text-gray-400 hover:text-gray-900 transition-colors text-2xl leading-none">×</button>
      </header>
      <ul id="dialog-stations-list" class="divide-y divide-gray-200 max-h-[60vh] overflow-y-auto"></ul>
      <footer class="px-5 py-3 border-t border-gray-200 text-xs text-gray-500">
        Source : Régie de l'énergie du Québec · Trié par prix régulier
      </footer>
    </div>
  </dialog>

</BaseLayout>

<style is:global>
  @keyframes visiteurs-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }
  .animate-pulse-slow {
    animation: pulse-slow 3s ease-in-out infinite;
  }
  @keyframes pulse-slow {
    0%, 100% { border-color: rgba(239, 68, 68, 0.5); }
    50% { border-color: rgba(239, 68, 68, 0.9); }
  }
  /* Reflow dynamique des grids de widgets quand certains sont masqués via Personnaliser. */
  .widget-grid[style*="--cols-base"] { grid-template-columns: repeat(var(--cols-base), minmax(0, 1fr)) !important; }
  @media (min-width: 640px) {
    .widget-grid[style*="--cols-sm"] { grid-template-columns: repeat(var(--cols-sm), minmax(0, 1fr)) !important; }
  }
  @media (min-width: 1024px) {
    .widget-grid[style*="--cols-lg"] { grid-template-columns: repeat(var(--cols-lg), minmax(0, 1fr)) !important; }
  }
</style>

<script is:inline define:vars={{ VAPID_PUBLIC_KEY }}>
  window.VAPID_PUBLIC_KEY = VAPID_PUBLIC_KEY;
</script>

<script>
  // ─── WMO codes ──────────────────────────────────────────────────────────────
  const WMO_DESC = {
    0: 'Ensoleillé', 1: 'Peu nuageux', 2: 'Partiellement nuageux', 3: 'Nuageux',
    45: 'Brouillard', 48: 'Brouillard givrant',
    51: 'Bruine légère', 53: 'Bruine', 55: 'Bruine forte',
    61: 'Pluie légère', 63: 'Pluie', 65: 'Forte pluie',
    71: 'Neige légère', 73: 'Neige', 75: 'Forte neige', 77: 'Grésil',
    80: 'Averses légères', 81: 'Averses', 82: 'Fortes averses',
    85: 'Averses de neige', 86: 'Fortes averses de neige',
    95: 'Orage', 96: 'Orage grêle', 99: 'Fort orage grêle',
  };
  const WMO_ICON = {
    0: '☀️', 1: '🌤️', 2: '⛅', 3: '☁️',
    45: '🌫️', 48: '🌫️',
    51: '🌧️', 53: '🌧️', 55: '🌧️',
    61: '🌧️', 63: '🌧️', 65: '🌧️',
    71: '❄️', 73: '❄️', 75: '❄️', 77: '❄️',
    80: '🌦️', 81: '🌦️', 82: '🌦️',
    85: '❄️', 86: '❄️',
    95: '⛈️', 96: '⛈️', 99: '⛈️',
  };

  // ─── Sources ─────────────────────────────────────────────────────────────────
  const SOURCES = {
    'radio-canada':   { label: 'Radio-Canada',       color: 'bg-blue-500',    url: 'https://ici.radio-canada.ca/abitibi-temiscamingue',  categorie: 'Média' },
    'tva-abitibi':    { label: 'TVA Abitibi',        color: 'bg-red-500',     url: 'https://tvaabitibi.ca/',                              categorie: 'Média' },
    'mon-abitibi':    { label: 'Mon Abitibi',        color: 'bg-yellow-500',  url: 'https://monabitibi.ca/',                              categorie: 'Média' },
    'le-citoyen':     { label: 'Le Citoyen',         color: 'bg-amber-500',   url: 'https://journallecitoyen.com/',                       categorie: 'Média' },
    'indice-bohemien':{ label: 'Indice bohémien',    color: 'bg-fuchsia-500', url: 'https://indicebohemien.org/',                         categorie: 'Culture' },
    'ville-lasarre':  { label: 'Ville de La Sarre',  color: 'bg-green-600',   url: 'https://www.lasarre.ca/actualites/',                  categorie: 'Municipal' },
    'avis-lasarre':   { label: 'Avis La Sarre',      color: 'bg-emerald-500', url: 'https://citoyen.lasarre.ca/avis',                     categorie: 'Municipal' },
    'mrcao':          { label: 'MRC Abitibi-Ouest',  color: 'bg-teal-500',    url: 'https://www.mrcao.qc.ca/fr/actualites/',              categorie: 'Municipal' },
    'cssla':          { label: 'CSSLA',              color: 'bg-orange-500',  url: 'https://cssla.gouv.qc.ca/',                           categorie: 'Éducation' },
    'uqat':           { label: 'UQAT',               color: 'bg-indigo-500',  url: 'https://www.uqat.ca/nouvelles-et-evenements/',        categorie: 'Éducation' },
    'cisss-at':       { label: 'CISSS-AT',           color: 'bg-pink-500',    url: 'https://www.cisss-at.gouv.qc.ca/communiques-de-presse/', categorie: 'Santé' },
    'ecole-musique-ao':{ label: 'École musique AO',  color: 'bg-rose-500',    url: 'https://ecolemusiqueao.ca/nouvelles/',                categorie: 'Culture' },
    'orezone':        { label: 'Orezone',             color: 'bg-stone-500',   url: 'https://orezone.com/press-releases/',                 categorie: 'Économie' },
  };

  // ─── Helpers ─────────────────────────────────────────────────────────────────
  function relativeTime(dateStr) {
    if (!dateStr) return '';
    const diff = (Date.now() - new Date(dateStr).getTime()) / 1000 / 3600;
    if (diff < 1) return 'à l\'instant';
    if (diff < 24) return `il y a ${Math.round(diff)}h`;
    return `il y a ${Math.round(diff / 24)}j`;
  }

  function frDate(dateStr) {
    if (!dateStr) return '';
    return new Date(dateStr).toLocaleDateString('fr-CA', { day: 'numeric', month: 'long', year: 'numeric' });
  }

  function fmtNum(n) {
    return typeof n === 'number' ? n.toLocaleString('fr-CA') : '—';
  }

  function extLinkIcon() {
    return `<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>`;
  }

  function widgetLabel(text, href, title) {
    const linkBit = href
      ? `<a href="${href}" target="_blank" rel="noopener noreferrer" title="${title || 'Voir la source'}" class="text-gray-400 hover:text-cjeao transition-colors">${extLinkIcon()}</a>`
      : '';
    return `<div class="flex items-center justify-between mb-1">
      <span class="text-xs font-bold text-cjeao tracking-wide uppercase">${text}</span>
      ${linkBit}
    </div>`;
  }

  function misAJour(dateStr) {
    return `<div class="text-xs text-gray-400 mt-auto pt-1.5">Mis à jour ${relativeTime(dateStr)}</div>`;
  }

  function miniLabel(text, href, title) {
    const linkBit = href
      ? `<a href="${href}" target="_blank" rel="noopener noreferrer" title="${title || 'Voir la source'}" class="text-gray-500 hover:text-cjeao transition-colors shrink-0">${extLinkIcon()}</a>`
      : '';
    return `<div class="flex items-center justify-between gap-1 mb-0.5">
      <span class="text-[0.65rem] font-bold text-cjeao tracking-wide uppercase truncate">${text}</span>
      ${linkBit}
    </div>`;
  }

  // ─── Mini-widget renderers (versions compactes) ───────────────────────────────

  function renderSopfeuMini(d) {
    const url = 'https://www.sopfeu.qc.ca/carte/';
    if (!d.saison_active) {
      return `${miniLabel('Risque feux', url)}<div class="text-sm text-gray-300">Hors saison</div>`;
    }
    // Codes couleurs officiels SOPFEU (palette identique à leur carte interactive)
    const SOPFEU_COLORS = {
      'Faible':     '#28398a', // bleu foncé (alias historique de "Bas")
      'Bas':        '#28398a', // bleu foncé
      'Modéré':     '#80c241', // vert
      'Élevé':      '#f4ed1f', // jaune vif
      'Très élevé': '#f7941d', // orange
      'Extrême':    '#ed1c24', // rouge
    };
    const color = SOPFEU_COLORS[d.niveau_danger] ?? '#9ca3af';
    return `
      ${miniLabel('Risque feux', url, 'Carte SOPFEU')}
      <div class="text-xl font-extrabold leading-tight" style="color: ${color}; text-shadow: 0 0 8px ${color}40;">${d.niveau_danger ?? '—'}</div>
      <div class="text-xs text-gray-400 truncate">${d.feux_actifs ?? 0} feu${(d.feux_actifs ?? 0) !== 1 ? 'x' : ''} actif${(d.feux_actifs ?? 0) !== 1 ? 's' : ''}</div>
    `;
  }

  function renderAlertesMini(d) {
    const url = 'https://meteo.gc.ca/warnings/?prov=qc';
    const nb = d.nb_alertes ?? 0;
    if (nb === 0) {
      return `${miniLabel('Alertes météo', url, 'Avertissements Env. Canada')}<div class="text-xl font-extrabold text-cjeao leading-tight">✓ Aucune</div><div class="text-xs text-gray-400">Aucun avertissement</div>`;
    }
    return `${miniLabel('Alertes météo', url)}<div class="text-xl font-extrabold text-red-400 leading-tight">${nb} alerte${nb !== 1 ? 's' : ''}</div><div class="text-xs text-red-300 truncate">${escapeHtml(d.alertes?.[0]?.titre ?? '')}</div>`;
  }

  function renderHydroMini(d) {
    const url = 'https://infopannes.solutions.hydroquebec.com/info-pannes/pannes/pannes-en-cours';
    const ok = (d.pannes_actives ?? 0) === 0;
    return ok
      ? `${miniLabel('Hydro-Québec', url, 'Carte des pannes')}<div class="text-xl font-extrabold text-cjeao leading-tight">✓ Normal</div><div class="text-xs text-gray-400">Aucune panne</div>`
      : `${miniLabel('Hydro-Québec', url, 'Carte des pannes')}<div class="text-xl font-extrabold text-red-400 leading-tight">${d.pannes_actives}</div><div class="text-xs text-gray-300">${fmtNum(d.clients_touches)} client${(d.clients_touches ?? 0) !== 1 ? 's' : ''}</div>`;
  }

  function renderBornesMini(d) {
    const url = 'https://lecircuitelectrique.com/trouver-une-borne/';
    return `${miniLabel('Bornes recharge', url, 'Le Circuit Électrique')}<div class="text-xl font-extrabold text-white leading-tight">${d.total_bornes ?? '—'}</div><div class="text-xs text-gray-400">${(d.bornes?.length ?? 0)} site${(d.bornes?.length ?? 0) !== 1 ? 's' : ''} ≤80 km</div>`;
  }

  function renderAirMini(d) {
    const url = 'https://www.environnement.gouv.qc.ca/air/iqa/';
    const c = (n) => n == null ? 'text-gray-300' : n <= 20 ? 'text-cjeao' : n <= 40 ? 'text-lime-400' : n <= 60 ? 'text-yellow-300' : n <= 80 ? 'text-orange-400' : 'text-red-400';
    return `${miniLabel('Qualité air', url, "Indice qualité de l'air")}<div class="flex items-baseline gap-2"><span class="text-xl font-extrabold ${c(d.aqi)} leading-tight">${d.aqi ?? '—'}</span><span class="text-xs text-gray-300 truncate">${d.niveau ?? ''}</span></div><div class="text-xs text-gray-400">PM2.5 ${d.pm25 ?? '—'}</div>`;
  }

  // ─── Widget renderers ─────────────────────────────────────────────────────────

  function renderMeteo(d) {
    const icon = WMO_ICON[d.code_meteo] ?? '🌡️';
    const desc = WMO_DESC[d.code_meteo] ?? 'Inconnu';
    const temp = Math.round(d.temperature);
    return `
      ${widgetLabel('Météo', 'https://meteo.gc.ca/fr/location/index.html?coords=48.8,-79.2', 'Prévisions détaillées (Environnement Canada)')}
      <div class="flex items-center gap-3">
        <span class="text-5xl leading-none">${icon}</span>
        <span class="text-4xl font-extrabold text-white">${temp}°C</span>
      </div>
      <div class="text-base text-gray-200">${desc}</div>
      <div class="text-sm text-gray-400">Vent ${d.vent_kmh ?? '—'} km/h · Humidité ${d.humidite ?? '—'}%</div>
      ${misAJour(d.mis_a_jour)}
    `;
  }

  function renderEssence(d) {
    const fmt = (n) => (typeof n === 'number') ? n.toFixed(1) : '—';
    window.__toutesStations = Array.isArray(d.toutes_stations) ? d.toutes_stations : [];
    const nbBtn = window.__toutesStations.length > 0
      ? `<button type="button" id="btn-voir-stations" class="mt-1 text-xs text-cjeao hover:text-white underline-offset-2 hover:underline transition-colors text-left">Voir les ${window.__toutesStations.length} stations →</button>`
      : '';
    return `
      ${widgetLabel('Essence', 'https://regieessencequebec.ca/', 'Prix sur Régie de l\'énergie du Québec')}
      <div class="text-xs text-gray-400 -mb-0.5">Le plus bas dans la MRC</div>
      <div class="text-4xl font-extrabold text-white">${fmt(d.prix_regulier)}<span class="text-xl font-normal text-gray-300">¢</span></div>
      <div class="text-sm text-gray-200">Diesel <span class="text-white font-semibold">${fmt(d.prix_diesel)}¢</span></div>
      ${d.prix_regulier_moyen ? `<div class="text-xs text-gray-500">Moy. MRC ${fmt(d.prix_regulier_moyen)}¢ · ${d.nb_stations ?? '—'} stations</div>` : ''}
      ${nbBtn}
      ${misAJour(d.mis_a_jour)}
    `;
  }

  // Widget Or (gros, dans Row 1) — affiche USD/oz et CAD/oz avec variation 7 jours
  function renderFinances(d) {
    const varPct = d.or_variation_pct_7d;
    const hasVar = varPct != null;
    const varColor = !hasVar ? 'text-gray-500' : varPct >= 0 ? 'text-cjeao' : 'text-red-400';
    const varSign  = !hasVar ? '' : varPct >= 0 ? '+' : '';
    const varTxt   = !hasVar ? '—' : `${varSign}${varPct}%`;
    return `
      ${widgetLabel('Or', 'https://www.kitco.com/charts/livegold.html', 'Cours détaillé de l\'or (Kitco)')}
      <div class="text-3xl font-extrabold text-white">${fmtNum(d.or_cad_oz)}<span class="text-base font-normal text-gray-300"> $CA/oz</span></div>
      <div class="text-sm text-gray-300">${fmtNum(d.or_usd_oz)}<span class="text-gray-400"> $US/oz</span></div>
      <div class="${varColor} text-sm font-semibold" title="Variation sur 7 jours">${varTxt} <span class="text-gray-500 font-normal">/ 7j</span></div>
