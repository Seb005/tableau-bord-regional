  // Mois français → numéro (1-12), pour parser les dates CCIAO type "15 mars".
  const MOIS_FR = {
    'janvier': 1, 'janv': 1, 'jan': 1,
    'février': 2, 'fevrier': 2, 'févr': 2, 'fevr': 2, 'fev': 2, 'feb': 2,
    'mars': 3, 'mar': 3,
    'avril': 4, 'avr': 4, 'apr': 4,
    'mai': 5,
    'juin': 6, 'jun': 6,
    'juillet': 7, 'juil': 7, 'jul': 7,
    'août': 8, 'aout': 8, 'aoû': 8, 'aug': 8,
    'septembre': 9, 'sept': 9, 'sep': 9,
    'octobre': 10, 'oct': 10,
    'novembre': 11, 'nov': 11,
    'décembre': 12, 'decembre': 12, 'déc': 12, 'dec': 12,
  };

  // Parser "YYYY-MM-DD" comme date locale (sinon Date interprète en UTC
  // et l'heure d'été décale d'un jour avant).
  function parseDateIsoLocale(s) {
    if (!s) return null;
    const [y, m, dd] = String(s).split('-').map(Number);
    if (!y || !m || !dd) return null;
    return new Date(y, m - 1, dd);
  }

  // Parser une date CCIAO "15 mars" (sans année) — l'année est déduite par
  // rapport à aujourd'hui (si le mois est passé, on prend l'année suivante).
  function parseDateCciao(s) {
    if (!s) return null;
    const parts = String(s).toLowerCase().trim().split(/\s+/);
    if (parts.length < 2) return null;
    const jour = parseInt(parts[0], 10);
    const moisStr = parts[1].replace(/\./g, '');
    const mois = MOIS_FR[moisStr];
    if (!jour || !mois) return null;
    const now = new Date();
    let annee = now.getFullYear();
    const candidate = new Date(annee, mois - 1, jour);
    const aujourdhui = new Date(annee, now.getMonth(), now.getDate());
    if (candidate < aujourdhui) annee += 1;
    return new Date(annee, mois - 1, jour);
  }

  // Source styling pour les pastilles.
  const SOURCES_AGENDA = {
    loisirs:   { label: 'Loisirs',  cls: 'bg-blue-500/15 text-blue-300 border-blue-500/30' },
    cciao:     { label: 'CCIAO',    cls: 'bg-amber-500/15 text-amber-300 border-amber-500/30' },
    carrefour: { label: 'Carrefour', cls: 'bg-cjeao/15 text-cjeao border-cjeao/30' },
  };

  // Normalise les 3 sources en un format commun : {source, titre, date (Date), heure, url}.
  function consoliderAgenda(loisirsData, cciaoData, carrefourActs) {
    const aujourdhui = new Date();
    aujourdhui.setHours(0, 0, 0, 0);
    const items = [];

    // Loisirs (YYYY-MM-DD)
    const portailLoisirs = 'https://loisirs.ao.ca/fr/';
    (loisirsData?.activites ?? []).forEach(a => {
      const dateObj = parseDateIsoLocale(a.date);
      if (a.date && (!dateObj || dateObj < aujourdhui)) return;
      items.push({
        source: 'loisirs',
        titre: a.titre ?? '—',
        date: dateObj,
        heure: a.heure || '',
        url: a.url || portailLoisirs,
      });
    });

    // CCIAO ("15 mars")
    const portailCciao = 'https://www.cciao.ca/fr/activites/';
    (cciaoData?.activites ?? []).forEach(a => {
      const dateObj = parseDateCciao(a.date);
      if (a.date && (!dateObj || dateObj < aujourdhui)) return;
      items.push({
        source: 'cciao',
        titre: a.titre ?? '—',
        date: dateObj,
        heure: '',
        url: a.url || portailCciao,
      });
    });

    // Carrefour (YYYY-MM-DD, heure_debut "HH:MM[:SS]")
    const portailCarrefour = '/activites';
    (carrefourActs ?? []).forEach(a => {
      const dateObj = parseDateIsoLocale(a.date);
      if (a.date && (!dateObj || dateObj < aujourdhui)) return;
      const heure = a.heure_debut ? String(a.heure_debut).slice(0, 5) : '';
      items.push({
        source: 'carrefour',
        titre: a.titre ?? '—',
        date: dateObj,
        heure,
        url: portailCarrefour,
      });
    });

    // Tri par date asc (entrées sans date à la fin)
    items.sort((x, y) => {
      if (!x.date && !y.date) return 0;
      if (!x.date) return 1;
      if (!y.date) return -1;
      return x.date - y.date;
    });
    return items;
  }

  // État de l'onglet actif (persisté en mémoire seulement)
  let agendaFiltreActif = 'tous';

  // Met à jour seulement la liste sans re-rendre tout le widget (préserve les onglets cliqués).
  function rendreListeAgenda(items) {
    const liste = document.getElementById('agenda-liste');
    if (!liste) return;
    const filtre = agendaFiltreActif;
    const filtres = filtre === 'tous' ? items : items.filter(i => i.source === filtre);
    if (filtres.length === 0) {
      liste.innerHTML = `<div class="col-span-full text-sm text-gray-300 px-2 py-3">Aucune activité à venir pour cette source.</div>`;
      return;
    }
    liste.innerHTML = filtres.slice(0, 12).map(a => {
      const src = SOURCES_AGENDA[a.source];
      const dateTxt = a.date
        ? a.date.toLocaleDateString('fr-CA', { weekday: 'short', day: 'numeric', month: 'short' })
        : '';
      const heure = a.heure ? ` ${a.heure}` : '';
      return `<a href="${a.url}" target="_blank" rel="noopener noreferrer"
                 class="group flex items-center justify-between gap-2 text-sm py-1.5 px-2 -mx-2 rounded hover:bg-gray-800/40 transition-colors">
        <span class="flex items-center gap-2 min-w-0">
          <span class="shrink-0 text-[10px] font-bold uppercase tracking-wide px-1.5 py-0.5 rounded border ${src.cls}">${src.label}</span>
          <span class="text-white truncate group-hover:text-cjeao transition-colors">${a.titre}</span>
        </span>
        <span class="text-xs text-gray-300 shrink-0">${dateTxt}${heure}</span>
      </a>`;
    }).join('');
  }

  // Branche les onglets sur clic — appelé après render initial.
  function brancherOngletsAgenda(items) {
    document.querySelectorAll('[data-agenda-tab]').forEach(btn => {
      btn.addEventListener('click', () => {
        agendaFiltreActif = btn.dataset.agendaTab;
        document.querySelectorAll('[data-agenda-tab]').forEach(b => {
          const actif = b.dataset.agendaTab === agendaFiltreActif;
          b.classList.toggle('bg-cjeao', actif);
          b.classList.toggle('text-dark', actif);
          b.classList.toggle('text-gray-300', !actif);
          b.classList.toggle('hover:bg-gray-800', !actif);
        });
        rendreListeAgenda(items);
      });
    });
  }

  function renderAgenda(loisirsData, cciaoData, carrefourActs) {
    const items = consoliderAgenda(loisirsData, cciaoData, carrefourActs);
    const inscription = 'https://profil.ao.ca/fr/creer/';

    const compteurs = {
      tous: items.length,
      loisirs: items.filter(i => i.source === 'loisirs').length,
      cciao: items.filter(i => i.source === 'cciao').length,
      carrefour: items.filter(i => i.source === 'carrefour').length,
    };

    const onglet = (key, label) => {
      const actif = agendaFiltreActif === key;
      const cls = actif
        ? 'bg-cjeao text-dark'
        : 'text-gray-300 hover:bg-gray-800';
      return `<button type="button" data-agenda-tab="${key}"
        class="text-xs font-semibold px-2.5 py-1 rounded-md transition-colors ${cls}">
        ${label} <span class="opacity-70">${compteurs[key]}</span>
      </button>`;
    };

    const ctaInscription = `
      <a href="${inscription}" target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center gap-1.5 text-xs font-semibold text-cjeao hover:text-white transition-colors">
        <span>Inscrivez vos activités</span>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>`;

    // Date la plus récente parmi les "mis_a_jour" des sources
    const majDates = [loisirsData?.mis_a_jour, cciaoData?.mis_a_jour].filter(Boolean);
    const majRecent = majDates.sort().slice(-1)[0];

    // Render initial (les onglets seront branchés juste après)
    const html = `
      ${widgetLabel('Agenda Abitibi-Ouest', 'https://loisirs.ao.ca/fr/', 'Loisirs · CCIAO · Carrefour')}
      <div class="flex items-center justify-between gap-3 flex-wrap">
        <div class="flex items-center gap-1 flex-wrap">
          ${onglet('tous', 'Tous')}
          ${onglet('loisirs', 'Loisirs')}
          ${onglet('cciao', 'CCIAO')}
          ${onglet('carrefour', 'Carrefour')}
        </div>
        ${ctaInscription}
      </div>
      <div id="agenda-liste" class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-0 mt-1"></div>
      ${majRecent ? misAJour(majRecent) : ''}
    `;

    // Stocker les items pour les onglets (différé : on doit attendre que le DOM soit en place)
    setTimeout(() => {
      rendreListeAgenda(items);
      brancherOngletsAgenda(items);
    }, 0);

    return html;
  }

  function renderAir(d) {
    const aqiColor = (n) => {
      if (n == null) return 'text-gray-300';
      if (n <= 20) return 'text-cjeao';
      if (n <= 40) return 'text-lime-400';
      if (n <= 60) return 'text-yellow-300';
      if (n <= 80) return 'text-orange-400';
      return 'text-red-400';
    };
    return `
      ${widgetLabel('Qualité de l\'air', 'https://www.environnement.gouv.qc.ca/air/iqa/', 'Indice qualité de l\'air')}
      <div class="flex items-baseline gap-3">
        <span class="text-3xl font-extrabold ${aqiColor(d.aqi)}">${d.aqi ?? '—'}</span>
        <span class="text-base text-gray-200">${d.niveau ?? ''}</span>
      </div>
      <div class="text-sm text-gray-300">PM2.5 ${d.pm25 ?? '—'} · PM10 ${d.pm10 ?? '—'}</div>
      <div class="text-xs text-gray-400">O₃ ${d.o3 ?? '—'} · NO₂ ${d.no2 ?? '—'}</div>
      ${misAJour(d.mis_a_jour)}
    `;
  }

  function renderAurores(d) {
    const url = 'https://www.swpc.noaa.gov/products/aurora-30-minute-forecast';
    const proba = d.probabilite_pct ?? 0;
    const probaColor = proba >= 60 ? 'text-cjeao' : proba >= 30 ? 'text-yellow-300' : 'text-gray-300';
    const visible = d.visible_quebec
      ? `<span class="text-cjeao font-semibold">✓ Possiblement visible</span>`
      : `<span class="text-gray-400">Peu probable</span>`;

    // Lune
    const luneEmoji = d.lune_emoji ?? '🌙';
    const lunePhase = d.lune_phase ?? '';
    const luneIllum = d.lune_illumination != null ? `${d.lune_illumination}%` : '';

    // Météores
    let meteoreHtml = '';
    if (d.meteore_nom) {
      const estPic = d.meteore_pic_debut && d.meteore_pic_fin && (() => {
        const now = new Date();
        const mmdd = `${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
        return mmdd >= d.meteore_pic_debut && mmdd <= d.meteore_pic_fin;
      })();
      const picBadge = estPic ? ' <span class="text-yellow-300 font-semibold">★ Pic!</span>' : '';
      meteoreHtml = `<div class="text-sm text-gray-200">☄️ ${d.meteore_nom}${picBadge} · ~${d.meteore_taux_horaire}/h</div>`;
    }

    return `
      ${widgetLabel('Ciel nocturne', url, 'Aurores · Lune · Météores')}
      <div class="flex items-baseline gap-3">
        <span class="text-2xl font-extrabold ${probaColor}">${proba}%</span>
        <span class="text-sm text-gray-200">aurores · Kp ${d.kp_index ?? '—'} · ${d.niveau ?? ''}</span>
      </div>
      <div class="text-xs">${visible}</div>
      <div class="text-sm text-gray-200 mt-0.5">${luneEmoji} ${lunePhase}${luneIllum ? ` · ${luneIllum} illuminée` : ''}</div>
      ${meteoreHtml}
      ${misAJour(d.mis_a_jour)}
    `;
  }

  function renderInternet(d) {
    const url = 'https://performance.cira.ca/';
    const fournisseurs = (() => {
      try { return typeof d.fournisseurs === 'string' ? JSON.parse(d.fournisseurs) : (d.fournisseurs || []); }
      catch { return []; }
    })();
    const comparaison = (() => {
      try { return typeof d.comparaison_qc === 'string' ? JSON.parse(d.comparaison_qc) : (d.comparaison_qc || {}); }
      catch { return {}; }
    })();

    const dl = d.mediane_download_mbps;
    const ul = d.mediane_upload_mbps;
    const dlColor = dl >= 50 ? 'text-cjeao' : dl >= 25 ? 'text-yellow-300' : 'text-red-400';

    // Comparaison avec la moyenne QC
    let compHtml = '';
    if (comparaison.download_qc_mbps) {
      const ratio = dl / comparaison.download_qc_mbps;
      const pct = Math.round((ratio - 1) * 100);
      if (pct < -5) {
        compHtml = `<span class="text-red-400">${Math.abs(pct)}% sous la moyenne QC</span>`;
      } else if (pct > 5) {
        compHtml = `<span class="text-cjeao">${pct}% au-dessus de la moyenne QC</span>`;
      } else {
        compHtml = `<span class="text-gray-300">≈ moyenne du Québec</span>`;
      }
    }

    // Top fournisseurs (max 2 — colonne étroite)
    const top = fournisseurs.slice(0, 2);
    const faiRows = top.map(f => {
      const dlVal = f.download_mbps != null ? `↓${f.download_mbps}` : '—';
      const ulVal = f.upload_mbps != null ? `↑${f.upload_mbps}` : '';
      return `<div class="flex justify-between text-xs">
        <span class="text-gray-200 truncate">${f.nom}</span>
        <span class="text-gray-300 font-mono">${dlVal} ${ulVal}</span>
      </div>`;
    }).join('');

    return `
      ${widgetLabel('Internet en Abitibi-Ouest', url, 'Données M-Lab · CIRA IPT')}
      <div class="flex items-baseline gap-3">
        <span class="text-3xl font-extrabold ${dlColor}">${dl ?? '—'}</span>
        <span class="text-sm text-gray-200">Mbps ↓ médiane</span>
        ${ul != null ? `<span class="text-sm text-gray-400">· ${ul} Mbps ↑</span>` : ''}
      </div>
      ${compHtml ? `<div class="text-xs">${compHtml}</div>` : ''}
      ${faiRows ? `<div class="mt-1.5 space-y-0.5 border-t border-gray-700 pt-1.5">${faiRows}</div>` : ''}
      <div class="text-xs text-gray-400 mt-1">${d.nb_tests ?? 0} tests · ${d.periode_jours ?? 180} derniers jours</div>
      ${misAJour(d.mis_a_jour)}
    `;
  }

  function renderTransport(d) {
    if (!d || !d.alerte) return null;
    const url = d.source_url || 'https://alertes.csdla.qc.ca/';
    return `
      <div class="bg-red-900/60 border border-red-500/50 rounded-xl p-4 flex items-start gap-3 animate-pulse-slow">
        <div class="text-3xl shrink-0 mt-0.5">🚌</div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-1">
            <span class="text-xs font-bold text-red-400 uppercase tracking-wide">Transport scolaire — Alerte</span>
            <a href="${url}" target="_blank" rel="noopener noreferrer" class="text-red-300 hover:text-white transition-colors">${extLinkIcon()}</a>
          </div>
          <div class="text-sm text-white font-semibold leading-snug">${d.message || 'Alerte en vigueur — consultez le site du CSS du Lac-Abitibi pour les détails.'}</div>
          <div class="text-xs text-red-300 mt-1.5">CSS du Lac-Abitibi · ${misAJourInline(d.mis_a_jour)}</div>
        </div>
      </div>
    `;
  }

  function misAJourInline(dateStr) {
    if (!dateStr) return '';
    return `Mis à jour ${relativeTime(dateStr)}`;
  }


  function renderEau(d) {
    const stations = Array.isArray(d.stations) ? d.stations : [];
    const url = 'https://www.cehq.gouv.qc.ca/hydrometrie/';
    if (stations.length === 0) {
      return `
        ${widgetLabel('Niveaux d\'eau', url, 'Centre d\'expertise hydrique')}
        <div class="text-sm text-gray-300">Aucune donnée</div>
        ${misAJour(d.mis_a_jour)}
      `;
    }
    const rows = stations.slice(0, 4).map(s => {
      const val = s.debit_m3s != null
        ? `${s.debit_m3s.toFixed(1)} <span class="text-xs text-gray-400">m³/s</span>`
        : s.niveau_m != null
          ? `${s.niveau_m.toFixed(1)} <span class="text-xs text-gray-400">m</span>`
          : '—';
      return `<div class="flex items-baseline justify-between gap-2 text-sm py-1 border-b border-gray-800 last:border-0">
        <span class="text-white truncate" title="${s.nom ?? ''}">${s.riviere ?? s.nom ?? '—'}</span>
        <span class="font-semibold text-cjeao shrink-0">${val}</span>
      </div>`;
    }).join('');
    return `
      ${widgetLabel('Niveaux d\'eau', url, 'Centre d\'expertise hydrique')}
      <div class="flex flex-col gap-0">${rows}</div>
      ${misAJour(d.mis_a_jour)}
    `;
  }

  // ─── Filtre pertinence Abitibi-Ouest ──────────────────────────────────────────
  // 23 municipalités de la MRC + références A-O explicites
  const AO_KEYWORDS = [
    'Abitibi-Ouest', 'MRC AO', 'Lac Abitibi',
    'La Sarre', 'Macamic', 'Palmarolle', 'Duparquet',
    'Authier-Nord', 'Authier', 'Chazel', 'Clerval', 'Clermont',
    'Dupuy', 'Gallichan', 'La Reine', 'Normétal', 'Poularies',
    'Rapide-Danseur', 'Roquemaure', 'Sainte-Germaine-Boulé',
    'Sainte-Hélène-de-Mancebourg', 'Saint-Lambert',
    'Taschereau', 'Val-Saint-Gilles', 'Saint-Vital-de-Clermont',
    "Hunter's Point",
  ];
  // Municipalités d'autres MRC d'A-T + régions voisines à exclure
  const AUTRE_MRC_KEYWORDS = [
    // MRC Abitibi (autour d'Amos)
    'Amos', 'Senneterre', 'Barraute', 'Landrienne', 'Trécesson', 'Preissac',
    'La Corne', 'Champneuf', 'Rochebaucourt', 'Sainte-Gertrude-Manneville',
    'Pikogan',
    // MRC Vallée-de-l'Or
    'Val-d\'Or', 'Malartic', 'Rivière-Héva', 'Belcourt', 'Lac-Simon',
    // Ville de Rouyn-Noranda et secteurs fusionnés
    'Rouyn-Noranda', 'Évain', 'Cadillac', 'Cléricy', 'D\'Alembert',
    // MRC Témiscamingue
    'Ville-Marie', 'Témiscamingue', 'Témiscaming', 'Kipawa', 'Lorrainville',
    'Notre-Dame-du-Nord', 'Belleterre', 'Rémigny', 'Latulipe',
    // Régions complètement autres
    'Nord-du-Québec', 'Eeyou Istchee', 'Jamésie',
  ];
  const reAO = new RegExp('\\b(' + AO_KEYWORDS.map(s => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|') + ')\\b', 'i');
  const reAutre = new RegExp('\\b(' + AUTRE_MRC_KEYWORDS.map(s => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|') + ')\\b', 'i');

  // Sources locales d'Abitibi-Ouest : toujours pertinentes peu importe le contenu
  const SOURCES_LOCALES_AO = new Set([
    'ville-lasarre', 'avis-lasarre', 'mrcao', 'cssla',
    'ecole-musique-ao'
  ]);

  function scoreArticleAO(a) {
    if (SOURCES_LOCALES_AO.has(a.source)) return 2; // source 100% locale
    const texte = `${a.titre ?? ''} ${a.resume ?? ''}`;
    const matchAO = reAO.test(texte);
    const matchAutre = reAutre.test(texte);
    if (matchAO) return 2;             // mention explicite A-O
    if (matchAutre) return -1;          // autre MRC sans A-O
    return 0;                           // neutre (régional/général)
  }

  // ─── Article row (liste compacte responsive) ─────────────────────────────────
  function renderArticle(a) {
    const src = SOURCES[a.source] ?? { label: a.source, color: 'bg-gray-500' };
    const isLocale = SOURCES_LOCALES_AO.has(a.source);
    // Couleur d'accent réservée aux sources 100% locales A-O ; les autres en gris neutre.
    const badgeCls = isLocale ? 'bg-cjeao text-dark' : 'bg-gray-700 text-white';
    const date = frDate(a.date_publication);
    const url = encodeURIComponent(a.url ?? '');
    const titre = encodeURIComponent(a.titre ?? '');
    return `
      <li class="group py-3 px-3 -mx-3 rounded-lg hover:bg-gray-100 transition-colors">
        <!-- Meta row : badge + date -->
        <div class="flex items-center justify-between gap-2 mb-1.5">
          <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold ${badgeCls} max-w-[55%] truncate" title="${src.label}">${src.label}</span>
          <span class="text-xs text-gray-500 shrink-0">${date}</span>
        </div>
        <!-- Title + excerpt -->
        <a href="${a.url}" target="_blank" rel="noopener noreferrer" class="block">
          <p class="font-semibold text-gray-900 group-hover:text-cjeao-darker transition-colors leading-snug">${a.titre ?? ''}</p>
          ${a.resume ? `<p class="text-sm text-gray-600 leading-relaxed mt-1 line-clamp-2">${a.resume}</p>` : ''}
        </a>
        <!-- Share row -->
        <div class="flex items-center gap-1 mt-2">
          <a href="https://twitter.com/intent/tweet?text=${titre}&url=${url}" target="_blank" rel="noopener noreferrer" aria-label="Partager sur X" class="w-10 h-10 inline-flex items-center justify-center text-gray-500 hover:bg-black hover:text-white rounded transition-colors">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://www.linkedin.com/sharing/share-offsite/?url=${url}" target="_blank" rel="noopener noreferrer" aria-label="Partager sur LinkedIn" class="w-10 h-10 inline-flex items-center justify-center text-gray-500 hover:bg-[#0a66c2] hover:text-white rounded transition-colors">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.778 13.019H3.555V9h3.56v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://www.facebook.com/sharer/sharer.php?u=${url}" target="_blank" rel="noopener noreferrer" aria-label="Partager sur Facebook" class="w-10 h-10 inline-flex items-center justify-center text-gray-500 hover:bg-[#1877f2] hover:text-white rounded transition-colors">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <button type="button" data-share-url="${a.url}" aria-label="Copier le lien" class="copier-lien w-10 h-10 inline-flex items-center justify-center text-gray-500 hover:bg-cjeao hover:text-dark rounded transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
          </button>
        </div>
      </li>
    `;
  }

  // Gestionnaire global pour le bouton "copier le lien"
  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('.copier-lien');
    if (!btn) return;
    e.preventDefault();
    const url = btn.dataset.shareUrl;
    try {
      await navigator.clipboard.writeText(url);
      const original = btn.innerHTML;
      btn.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>';
      btn.classList.add('bg-cjeao', 'text-dark');
      setTimeout(() => { btn.innerHTML = original; btn.classList.remove('bg-cjeao', 'text-dark'); }, 1500);
    } catch (err) {
      console.warn('Clipboard error:', err);
    }
  });

  // ─── Fetch & render ───────────────────────────────────────────────────────────
  // ─── Sources surveillées ──────────────────────────────────────────────────────
  function renderSources(compteParSource, dernierParSource) {
    const grid = document.getElementById('sources-grid');
    if (!grid) return;

    // Trier : par catégorie puis par label
    const entries = Object.entries(SOURCES).sort((a, b) => {
      if (a[1].categorie !== b[1].categorie) return a[1].categorie.localeCompare(b[1].categorie);
      return a[1].label.localeCompare(b[1].label);
    });

    grid.innerHTML = entries.map(([tag, src]) => {
      const count = compteParSource[tag] ?? 0;
      const dernier = dernierParSource[tag];
      const dernierStr = dernier
        ? `Dernière nouvelle ${relativeTime(dernier)}`
        : 'En attente d\'une nouvelle publication';
      const countBadge = count > 0
        ? `<span class="text-cjeao-darker font-semibold text-sm">${count} récente${count !== 1 ? 's' : ''}</span>`
        : `<span class="text-gray-400 text-sm">·</span>`;
      return `
        <a href="${src.url}" target="_blank" rel="noopener noreferrer"
           class="group flex items-start gap-3 bg-white border border-gray-200 rounded-lg p-3 hover:border-cjeao hover:shadow-sm transition-all">
          <span class="inline-flex shrink-0 w-2.5 h-2.5 mt-1.5 rounded-full ${SOURCES_LOCALES_AO.has(tag) ? 'bg-cjeao' : 'bg-gray-400'}"></span>
          <div class="flex-1 min-w-0">
            <div class="flex items-baseline justify-between gap-2">
              <span class="font-semibold text-gray-900 group-hover:text-cjeao-darker transition-colors truncate">${src.label}</span>
              ${countBadge}
            </div>
            <div class="flex items-baseline justify-between gap-2 mt-0.5">
              <span class="text-xs text-gray-500 uppercase tracking-wide">${src.categorie}</span>
              <span class="text-xs text-gray-500">${dernierStr}</span>
            </div>
          </div>
        </a>
      `;
    }).join('');
  }

  // ─── Rendu des articles avec respect du filtre A-Ouest ────────────────────────
  function rendreArticles() {
    const list = document.getElementById('articles-list');
    if (!list) return;
    const bruts = window.__articlesBruts || [];
    const filtreOn = document.getElementById('filtre-ao')?.checked ?? true;

    const filtres = filtreOn ? bruts.filter(a => scoreArticleAO(a) >= 0) : bruts;
    const masques = bruts.length - filtres.length;

    if (filtres.length > 0) {
      list.innerHTML = filtres.map(renderArticle).join('');
    } else if (bruts.length > 0) {
      list.innerHTML = '<li class="text-gray-500 text-sm py-4">Aucun article pertinent pour l\'Abitibi-Ouest dans la dernière période. Décochez le filtre pour voir tout.</li>';
    } else {
      list.innerHTML = '<li class="text-gray-500 text-sm py-4">Aucun article disponible pour le moment.</li>';
    }

    const info = document.getElementById('filtre-info');
    if (info) {
      info.textContent = filtreOn && masques > 0
        ? `(${masques} article${masques !== 1 ? 's' : ''} d'autres MRC masqué${masques !== 1 ? 's' : ''})`
        : '';
    }
  }

  document.getElementById('filtre-ao')?.addEventListener('change', rendreArticles);

  // Variables Supabase publiques injectées au build (mêmes que la page Activités).
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL || '';
  const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';

  // Mapping clé widget → table Supabase (doit rester aligné avec nouvelles-proxy.js).
  const TABLES_NOUVELLES = {
    meteo: 'nouvelles_meteo',
    essence: 'nouvelles_essence',
    sopfeu: 'nouvelles_sopfeu',
    finances: 'nouvelles_finances',
    hydro: 'nouvelles_hydro',
    routes: 'nouvelles_routes',
    alertes: 'nouvelles_alertes',
    urgences: 'nouvelles_urgences',
    emplois: 'nouvelles_emplois',
    bornes: 'nouvelles_bornes_electriques',
    loisirs: 'nouvelles_activites_loisirs',
    air: 'nouvelles_air',
    aurores: 'nouvelles_aurores',
    eau: 'nouvelles_eau',
    internet: 'nouvelles_internet',
    cciao: 'nouvelles_cciao',
    transport: 'nouvelles_transport',
  };

  // Fallback : interroge Supabase directement si le proxy Netlify est indisponible.
  async function chargerDepuisSupabase() {
    if (!SUPABASE_URL || !SUPABASE_ANON_KEY) throw new Error('Config Supabase absente');
    const h = { apikey: SUPABASE_ANON_KEY, Authorization: `Bearer ${SUPABASE_ANON_KEY}` };
    const cles = Object.keys(TABLES_NOUVELLES);
    const depuis30j = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString();
    const reqs = cles.map((cle) =>
      fetch(`${SUPABASE_URL}/rest/v1/${TABLES_NOUVELLES[cle]}?select=*`, { headers: h })
        .then((r) => (r.ok ? r.json() : []))
        .catch(() => [])
    );
    reqs.push(
      fetch(`${SUPABASE_URL}/rest/v1/nouvelles_articles?select=*&date_publication=gte.${depuis30j}&order=date_publication.desc&limit=40`, { headers: h })
        .then((r) => (r.ok ? r.json() : []))
        .catch(() => [])
    );
    // Activités du Carrefour (table activites) — à venir, exclut fermetures/fériés
    const aujourdhuiIso = new Date().toISOString().slice(0, 10);
    reqs.push(
      fetch(`${SUPABASE_URL}/rest/v1/activites?select=id,titre,date,heure_debut,type&date=gte.${aujourdhuiIso}&type=not.in.(ferme,ferie)&order=date.asc,heure_debut.asc.nullslast&limit=30`, { headers: h })
        .then((r) => (r.ok ? r.json() : []))
        .catch(() => [])
    );
    const res = await Promise.all(reqs);
    const data = {};
    cles.forEach((cle, i) => {
      data[cle] = Array.isArray(res[i]) ? (res[i][0] ?? null) : null;
    });
    data.articles = Array.isArray(res[cles.length]) ? res[cles.length] : [];
    data.carrefour_activites = Array.isArray(res[cles.length + 1]) ? res[cles.length + 1] : [];
    return data;
  }

  // Lit Supabase DIRECTEMENT d'abord (0 invocation Netlify — anon a SELECT sur les
  // tables nouvelles_* via RLS). Le proxy Netlify ne sert plus que de filet de
  // secours si la lecture directe échoue (config absente, etc.).
  async function recupererNouvelles() {
    try {
      return await chargerDepuisSupabase();
    } catch (errDirect) {
      console.warn('[nouvelles] Supabase direct indisponible, fallback proxy Netlify:', errDirect.message);
      const res = await fetch('/.netlify/functions/nouvelles-proxy');
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      if (data && data.error) throw new Error(data.error);
      // Le proxy ne retourne pas (encore) les activités Carrefour — fallback vide.
      if (!Array.isArray(data.carrefour_activites)) data.carrefour_activites = [];
      return data;
    }
  }

  // Applique un jeu de données (proxy OU Supabase direct) à tous les widgets.
  function appliquerDonnees(data) {
      // Widgets
      const wMeteo    = document.getElementById('widget-meteo');
      const wEssence  = document.getElementById('widget-essence');
      const wFinances = document.getElementById('widget-finances');
      const wDevises  = document.getElementById('widget-devises');
      const wSopfeu   = document.getElementById('widget-sopfeu');
      const wAlertes  = document.getElementById('widget-alertes');
      const wHydro    = document.getElementById('widget-hydro');
      const wRoutes   = document.getElementById('widget-routes');
      const wUrgences = document.getElementById('widget-urgences');
      const wEmplois  = document.getElementById('widget-emplois');
      const wBornes   = document.getElementById('widget-bornes');
      const wLoisirs  = document.getElementById('widget-loisirs');
      const wAir      = document.getElementById('widget-air');
      const wAurores  = document.getElementById('widget-aurores');
      const wEau      = document.getElementById('widget-eau');
      const wInternet = document.getElementById('widget-internet');
      const wTransport = document.getElementById('widget-transport');

      if (wMeteo    && data.meteo)    wMeteo.innerHTML    = renderMeteo(data.meteo);
      if (wEssence  && data.essence)  wEssence.innerHTML  = renderEssence(data.essence);
      if (wFinances && data.finances) wFinances.innerHTML = renderFinances(data.finances);
      if (wDevises  && data.finances) wDevises.innerHTML  = renderDevisesMini(data.finances);
      if (wSopfeu   && data.sopfeu)   wSopfeu.innerHTML   = renderSopfeuMini(data.sopfeu);
      if (wAlertes  && data.alertes)  wAlertes.innerHTML  = renderAlertesMini(data.alertes);
      if (wHydro    && data.hydro)    wHydro.innerHTML    = renderHydroMini(data.hydro);
      if (wRoutes   && data.routes)   wRoutes.innerHTML   = renderRoutes(data.routes);
      if (wUrgences && data.urgences) wUrgences.innerHTML = renderUrgences(data.urgences);
      if (wEmplois  && data.emplois)  wEmplois.innerHTML  = renderEmplois(data.emplois);
      if (wBornes   && data.bornes)   wBornes.innerHTML   = renderBornesMini(data.bornes);
      if (wLoisirs) wLoisirs.innerHTML = renderAgenda(data.loisirs, data.cciao, data.carrefour_activites);
      if (wAir      && data.air)      wAir.innerHTML      = renderAirMini(data.air);
      if (wAurores  && data.aurores)  wAurores.innerHTML  = renderAurores(data.aurores);
      if (wEau      && data.eau)      wEau.innerHTML      = renderEau(data.eau);
      if (wInternet && data.internet) wInternet.innerHTML = renderInternet(data.internet);
      if (wTransport && data.transport) {
        const html = renderTransport(data.transport);
        if (html) {
          wTransport.innerHTML = html;
          wTransport.classList.remove('hidden');
        }
      }

      // Articles — on garde TOUS les articles bruts pour pouvoir basculer le filtre
      window.__articlesBruts = Array.isArray(data.articles) ? data.articles : [];
      rendreArticles();

      // Sources surveillées : compter les articles récents (30j) par source
      const articles = Array.isArray(data.articles) ? data.articles : [];
      const compteParSource = {};
      const dernierParSource = {};
      for (const a of articles) {
        compteParSource[a.source] = (compteParSource[a.source] ?? 0) + 1;
        if (!dernierParSource[a.source] || new Date(a.date_publication) > new Date(dernierParSource[a.source])) {
          dernierParSource[a.source] = a.date_publication;
        }
      }
      renderSources(compteParSource, dernierParSource);
  }

  // Chargement initial : proxy d'abord (1 appel Netlify agrégé), fallback Supabase direct.
  async function chargerNouvelles() {
    try {
      appliquerDonnees(await recupererNouvelles());
    } catch (err) {
      console.error('[nouvelles]', err);
      // Show error state in each widget
      const ids = ['widget-meteo','widget-essence','widget-finances','widget-devises','widget-sopfeu','widget-alertes','widget-hydro','widget-routes','widget-urgences','widget-emplois','widget-bornes','widget-loisirs','widget-air','widget-aurores','widget-eau','widget-internet'];
      for (const id of ids) {
        const el = document.getElementById(id);
        if (el) el.innerHTML = '<div class="text-xs text-gray-600 font-mono">Données indisponibles</div>';
      }
      const list = document.getElementById('articles-list');
      if (list) list.innerHTML = '<li class="text-gray-500 text-sm py-4">Impossible de charger les articles.</li>';
      // Toujours afficher les sources même si le fetch échoue
      renderSources({}, {});
    }
  }

  // ─── Commentaires ────────────────────────────────────────────────────────────
  function frDateHeure(dateStr) {
    if (!dateStr) return '';
    return new Date(dateStr).toLocaleDateString('fr-CA', { day: 'numeric', month: 'long' });
  }

  async function chargerCommentaires() {
    const list = document.getElementById('commentaires-list');
    if (!list) return;
    try {
      const res = await fetch('/.netlify/functions/nouvelles-commentaire');
      const data = await res.json();
      const comms = data.commentaires || [];
      if (comms.length === 0) {
        list.innerHTML = '<li class="py-4 px-4 text-sm text-gray-500">Aucune suggestion pour l\'instant. Soyez la première personne à en partager une!</li>';
        return;
      }
      list.innerHTML = comms.map(c => `
        <li class="py-3 px-4">
          <div class="flex items-baseline justify-between gap-2 mb-1">
            <span class="font-semibold text-gray-900 text-sm">${escapeHtml(c.nom)}</span>
            <span class="text-xs text-gray-500 shrink-0">${frDateHeure(c.created_at)}</span>
          </div>
          <p class="text-sm text-gray-700 whitespace-pre-line leading-relaxed">${escapeHtml(c.message)}</p>
        </li>
      `).join('');
    } catch (err) {
      console.error('[commentaires]', err);
      list.innerHTML = '<li class="py-4 px-4 text-sm text-gray-500">Impossible de charger les suggestions.</li>';
    }
  }

  function escapeHtml(s) {
    return String(s ?? '').replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
  }

  const form = document.getElementById('form-commentaire');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const statut = document.getElementById('c-status');
      const btn = form.querySelector('button[type="submit"]');
      const data = {
        nom: form.nom.value,
        courriel: form.courriel.value,
        message: form.message.value,
        website: form.website.value,
      };
      statut.textContent = 'Envoi…';
      statut.className = 'text-sm text-gray-500';
      btn.disabled = true;
      try {
        const res = await fetch('/.netlify/functions/nouvelles-commentaire', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const result = await res.json();
        if (res.ok) {
          statut.textContent = '✓ Merci! Votre message a été reçu.';
          statut.className = 'text-sm text-cjeao-darker font-semibold';
          form.reset();
          chargerCommentaires(); // refresh la liste
        } else {
          statut.textContent = result.error || 'Erreur lors de l\'envoi.';
          statut.className = 'text-sm text-red-600';
        }
      } catch (err) {
        statut.textContent = 'Erreur réseau. Réessayez.';
        statut.className = 'text-sm text-red-600';
      } finally {
        btn.disabled = false;
      }
    });
  }

  // ─── Date et heure en vedette ─────────────────────────────────────────────────
  function majDateHeure() {
    const now = new Date();
    const dateEl = document.getElementById('date-aujourdhui');
    const heureEl = document.getElementById('heure-aujourdhui');
    if (dateEl) {
      dateEl.textContent = now.toLocaleDateString('fr-CA', {
        weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'
      });
    }
    if (heureEl) {
      heureEl.textContent = now.toLocaleTimeString('fr-CA', { hour: '2-digit', minute: '2-digit', hour12: false });
    }
  }
  majDateHeure();
  setInterval(majDateHeure, 30 * 1000); // refresh every 30s

  // ─── Visiteurs en temps réel (Plausible) ──────────────────────────────────────
  async function majVisiteurs() {
    try {
      const res = await fetch('/.netlify/functions/nouvelles-visiteurs', { cache: 'no-store' });
      const data = await res.json();
      const bloc = document.getElementById('visiteurs-bloc');
      const nb = document.getElementById('visiteurs-nombre');
      if (data.visiteurs == null || data.error) {
        if (bloc) { bloc.classList.add('hidden'); bloc.classList.remove('inline-flex'); }
        return;
      }
      if (nb) nb.textContent = data.visiteurs;
      if (bloc) { bloc.classList.remove('hidden'); bloc.classList.add('inline-flex'); }
    } catch (err) { /* silencieux */ }
  }
  majVisiteurs();
  // Toutes les 5 min, et seulement si l'onglet est visible (Plausible compte déjà
  // les visiteurs des 5 dernières minutes — inutile de marteler la fonction Netlify).
  setInterval(() => { if (!document.hidden) majVisiteurs(); }, 5 * 60 * 1000);

  // ─── PWA : enregistrement du service worker + bouton d'installation ──────────
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('/sw.js').catch((err) => {
      console.warn('SW registration failed:', err);
    });
  }

  // Détection iOS Safari (les autres navigateurs iOS ne supportent pas l'install)
  const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
  const isSafari = /^((?!chrome|crios|fxios|edgios).)*safari/i.test(navigator.userAgent);
  const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
  const btnInstall = document.getElementById('btn-installer');

  // Si déjà installé (lancée depuis l'écran d'accueil), on cache tout
  if (!isStandalone && btnInstall) {
    if (isIOS && isSafari) {
      // iOS Safari : on affiche le bouton dès le départ, le clic ouvre le popup d'instructions.
      // Sauf si l'utilisateur a coché "Ne plus afficher".
      if (localStorage.getItem('cjeao_ios_install_dismissed') !== '1') {
        btnInstall.classList.remove('hidden');
        btnInstall.classList.add('inline-flex');
      }
    }
    // Android / Chrome desktop : le bouton apparaît seulement quand le navigateur propose l'install
  }

  // Cas Android / Chromium : capture l'événement et change le comportement du bouton
  let promptInstall = null;
  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    promptInstall = e;
    if (btnInstall && !isStandalone) {
      btnInstall.classList.remove('hidden');
      btnInstall.classList.add('inline-flex');
    }
  });

  if (btnInstall) {
    btnInstall.addEventListener('click', async () => {
      if (promptInstall) {
        // Android : prompt natif
        promptInstall.prompt();
        const { outcome } = await promptInstall.userChoice;
        promptInstall = null;
        if (outcome === 'accepted') {
          btnInstall.classList.add('hidden');
          btnInstall.classList.remove('inline-flex');
        }
      } else if (isIOS) {
        // iOS : ouvrir le popup d'instructions
        document.getElementById('dialog-ios-install')?.showModal();
      }
    });
  }

  // Boutons du popup iOS
  document.getElementById('dialog-ios-close')?.addEventListener('click', () => {
    document.getElementById('dialog-ios-install')?.close();
  });
  document.getElementById('ios-ok')?.addEventListener('click', () => {
    document.getElementById('dialog-ios-install')?.close();
  });
  document.getElementById('ios-ne-plus-afficher')?.addEventListener('click', () => {
    localStorage.setItem('cjeao_ios_install_dismissed', '1');
    document.getElementById('dialog-ios-install')?.close();
    if (btnInstall) {
      btnInstall.classList.add('hidden');
      btnInstall.classList.remove('inline-flex');
    }
  });
  // Fermer en cliquant sur le backdrop
  document.getElementById('dialog-ios-install')?.addEventListener('click', (e) => {
    if (e.target.id === 'dialog-ios-install') e.target.close();
  });

  window.addEventListener('appinstalled', () => {
    if (btnInstall) {
      btnInstall.classList.add('hidden');
      btnInstall.classList.remove('inline-flex');
    }
  });

  // ─── Notifications push : opt-in alertes urgentes ─────────────────────────────
  const VAPID_PUB = window.VAPID_PUBLIC_KEY || '';
  const btnAlertes = document.getElementById('btn-alertes');
  const dlgAlertes = document.getElementById('dialog-alertes');
  const pushSupporte = 'serviceWorker' in navigator && 'PushManager' in window && 'Notification' in window;

  function urlBase64ToUint8Array(base64String) {
    const padding = '='.repeat((4 - base64String.length % 4) % 4);
    const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
    const raw = atob(base64);
    const out = new Uint8Array(raw.length);
    for (let i = 0; i < raw.length; i++) out[i] = raw.charCodeAt(i);
    return out;
  }

  async function dejaAbonne() {
    if (!pushSupporte) return false;
    try {
      const reg = await navigator.serviceWorker.ready;
      const sub = await reg.pushManager.getSubscription();
      return !!sub;
    } catch { return false; }
  }

  function majBoutonAlertes() {
    if (!btnAlertes || !pushSupporte) return;
    // Cacher si permission déjà refusée ou déjà accordée+abonné
    if (Notification.permission === 'denied') {
      btnAlertes.classList.add('hidden');
      btnAlertes.classList.remove('inline-flex');
      return;
    }
    dejaAbonne().then((abonne) => {
      if (abonne) {
        btnAlertes.classList.add('hidden');
        btnAlertes.classList.remove('inline-flex');
      } else {
        btnAlertes.classList.remove('hidden');
        btnAlertes.classList.add('inline-flex');
      }
    });
  }

  async function activerAlertes() {
    const erreur = document.getElementById('alertes-erreur');
    erreur?.classList.add('hidden');

    if (!pushSupporte) {
      if (erreur) {
        erreur.textContent = 'Ce navigateur ne supporte pas les notifications push.';
        erreur.classList.remove('hidden');
      }
      return;
    }
    // iOS : faut être en mode standalone (installé)
    if (isIOS && !isStandalone) {
      document.getElementById('alertes-ios-help')?.classList.remove('hidden');
      return;
    }
    if (!VAPID_PUB) {
      if (erreur) {
        erreur.textContent = 'Configuration incomplète (clé serveur manquante).';
        erreur.classList.remove('hidden');
      }
      return;
    }

    try {
      const reg = await navigator.serviceWorker.ready;
      const permission = await Notification.requestPermission();
      if (permission !== 'granted') {
        if (erreur) {
          erreur.textContent = permission === 'denied'
            ? 'Permission refusée. Activez les notifications dans les réglages du navigateur.'
            : 'Permission non accordée.';
          erreur.classList.remove('hidden');
        }
        return;
      }

      const sub = await reg.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: urlBase64ToUint8Array(VAPID_PUB),
      });

      const subJson = sub.toJSON();
      const res = await fetch('/.netlify/functions/push-subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          endpoint: sub.endpoint,
          keys: subJson.keys,
          userAgent: navigator.userAgent,
        }),
      });

      if (!res.ok) {
        throw new Error('Échec enregistrement serveur');
      }

      dlgAlertes?.close();
      majBoutonAlertes();
      // Notification locale de confirmation
      try {
        await reg.showNotification('Alertes activées', {
          body: 'Vous recevrez les alertes urgentes de la région.',
          icon: '/icon-192.png',
          tag: 'cjeao-bienvenue',
        });
      } catch {}
    } catch (err) {
      if (erreur) {
        erreur.textContent = 'Erreur : ' + (err?.message || err);
        erreur.classList.remove('hidden');
      }
    }
  }

  if (btnAlertes) {
    btnAlertes.addEventListener('click', () => {
      document.getElementById('alertes-erreur')?.classList.add('hidden');
      document.getElementById('alertes-ios-help')?.classList.toggle('hidden', !(isIOS && !isStandalone));
      dlgAlertes?.showModal();
    });
  }
  document.getElementById('alertes-activer')?.addEventListener('click', activerAlertes);
  document.getElementById('alertes-plus-tard')?.addEventListener('click', () => {
    localStorage.setItem('cjeao_alertes_prompt_seen', '1');
    dlgAlertes?.close();
  });
  document.getElementById('dialog-alertes-close')?.addEventListener('click', () => dlgAlertes?.close());
  dlgAlertes?.addEventListener('click', (e) => {
    if (e.target.id === 'dialog-alertes') e.target.close();
  });

  majBoutonAlertes();

  // Prompt automatique au premier démarrage en standalone après installation
  if (isStandalone && pushSupporte && Notification.permission === 'default'
      && !localStorage.getItem('cjeao_alertes_prompt_seen')) {
    setTimeout(() => {
      dlgAlertes?.showModal();
      localStorage.setItem('cjeao_alertes_prompt_seen', '1');
    }, 1500);
  }

  // ─── Bannière iOS proactive (bottom-sheet d'installation) ─────────────────────
  // Apparaît sur iPhone Safari, pas encore installé, pas dismissé récemment.
  if (isIOS && isSafari && !isStandalone) {
    const dismissUntil = parseInt(localStorage.getItem('cjeao_ios_banner_dismiss_until') || '0', 10);
    if (Date.now() > dismissUntil) {
      const banner = document.getElementById('ios-banner');
      if (banner) {
        setTimeout(() => {
          banner.classList.remove('hidden');
        }, 6000);
        document.getElementById('ios-banner-cta')?.addEventListener('click', () => {
          banner.classList.add('hidden');
          document.getElementById('dialog-ios-install')?.showModal();
        });
        document.getElementById('ios-banner-close')?.addEventListener('click', () => {
          banner.classList.add('hidden');
          // Re-proposer dans 7 jours
          localStorage.setItem('cjeao_ios_banner_dismiss_until', String(Date.now() + 7 * 24 * 3600 * 1000));
        });
      }
    }
  }

  // ─── Popup stations d'essence ─────────────────────────────────────────────────
  function ouvrirDialogStations() {
    const dialog = document.getElementById('dialog-stations');
    const list = document.getElementById('dialog-stations-list');
    const stations = window.__toutesStations || [];
    if (!dialog || !list) return;
    const prixMin = stations.reduce((m, s) => s.prix_regulier != null && s.prix_regulier < m ? s.prix_regulier : m, Infinity);
    list.innerHTML = stations.map(s => {
      const reg = s.prix_regulier != null ? s.prix_regulier.toFixed(1) + '¢' : '—';
      const die = s.prix_diesel != null ? s.prix_diesel.toFixed(1) + '¢' : '—';
      const estMin = s.prix_regulier === prixMin;
      return `
        <li class="px-5 py-3 ${estMin ? 'bg-cjeao/10' : ''}">
          <div class="flex items-baseline justify-between gap-3 mb-1">
            <div class="min-w-0">
              <div class="font-semibold text-gray-900 truncate">
                ${escapeHtml(s.nom ?? '—')}
                ${estMin ? '<span class="ml-1 text-[0.65rem] font-bold uppercase tracking-wider bg-cjeao text-dark px-1.5 py-0.5 rounded">Min</span>' : ''}
              </div>
              <div class="text-xs text-gray-500 truncate">${escapeHtml(s.adresse ?? s.ville ?? '')}</div>
            </div>
            <div class="text-right shrink-0">
              <div class="text-lg font-extrabold text-gray-900 tabular-nums">${reg}</div>
              <div class="text-xs text-gray-500">Diesel ${die}</div>
            </div>
          </div>
        </li>
      `;
    }).join('') || '<li class="px-5 py-6 text-center text-gray-500 text-sm">Aucune station chargée.</li>';
    dialog.showModal();
  }

  document.addEventListener('click', (e) => {
    if (e.target.closest('#btn-voir-stations')) {
      e.preventDefault();
      ouvrirDialogStations();
    }
    if (e.target.id === 'dialog-stations-close') {
      document.getElementById('dialog-stations')?.close();
    }
  });

  // Fermer le dialog si on clique sur le backdrop
  document.getElementById('dialog-stations')?.addEventListener('click', (e) => {
    if (e.target.id === 'dialog-stations') e.target.close();
  });

  // ─── Analytics : tracker les clics sur widgets et articles ────────────────────
  function track(eventName, params = {}) {
    if (typeof window.gtag === 'function') {
      window.gtag('event', eventName, params);
    }
    // Plausible (chargé si présent — gracefully no-op sinon)
    if (typeof window.plausible === 'function') {
      window.plausible(eventName, { props: params });
    }
  }

  // Délégation globale : tracker tout lien sortant ou bouton significatif
  document.addEventListener('click', (e) => {
    const widgetLink = e.target.closest('[id^="widget-"] a[href^="http"]');
    if (widgetLink) {
      const widgetId = widgetLink.closest('[id^="widget-"]').id.replace('widget-', '');
      track('widget_click', { widget: widgetId, url: widgetLink.href });
      return;
    }
    const articleLink = e.target.closest('#articles-list a[href^="http"]');
    if (articleLink) {
      const li = articleLink.closest('li');
      const badge = li?.querySelector('span[class*="bg-"]')?.textContent?.trim() || 'inconnu';
      track('article_click', { source: badge, url: articleLink.href });
      return;
    }
    const shareBtn = e.target.closest('a[href*="twitter.com/intent"], a[href*="linkedin.com/sharing"], a[href*="facebook.com/sharer"]');
    if (shareBtn) {
      let reseau = 'autre';
      if (shareBtn.href.includes('twitter.com')) reseau = 'twitter';
      else if (shareBtn.href.includes('linkedin.com')) reseau = 'linkedin';
      else if (shareBtn.href.includes('facebook.com')) reseau = 'facebook';
      track('partage', { reseau });
    }
    if (e.target.closest('#btn-installer')) track('pwa_installer_clic');
    if (e.target.closest('#btn-voir-stations')) track('voir_stations_essence');
  });

  // ─── Personnalisation des widgets ──────────────────────────────────────────
  const PREFS_KEY = 'cjeao-widget-prefs';
  const WIDGET_REGISTRY = [
    { id: 'widget-transport',label: 'Transport scolaire',   group: 'Essentiel' },
    { id: 'widget-meteo',     label: 'Météo',               group: 'Essentiel' },
    { id: 'widget-essence',   label: 'Essence',             group: 'Essentiel' },
    { id: 'widget-finances',  label: 'Or',                  group: 'Essentiel' },
    { id: 'widget-devises',   label: 'Devises (USD · EUR)', group: 'En un coup d\'œil' },
    { id: 'widget-urgences',  label: 'Urgences',            group: 'Essentiel' },
    { id: 'widget-sopfeu',    label: 'SOPFEU',              group: 'En un coup d\'œil' },
    { id: 'widget-alertes',   label: 'Alertes météo',       group: 'En un coup d\'œil' },
    { id: 'widget-hydro',     label: 'Hydro-Québec',        group: 'En un coup d\'œil' },
    { id: 'widget-bornes',    label: 'Bornes électriques',  group: 'En un coup d\'œil' },
    { id: 'widget-air',       label: 'Qualité de l\'air',   group: 'En un coup d\'œil' },
    { id: 'widget-routes',    label: 'Routes',              group: 'Vie quotidienne' },
    { id: 'widget-loisirs',   label: 'Agenda Abitibi-Ouest', group: 'Vie quotidienne' },
    { id: 'widget-aurores',   label: 'Ciel nocturne',       group: 'Vie quotidienne' },
    { id: 'widget-eau',       label: 'Niveaux d\'eau',      group: 'Vie quotidienne' },
    { id: 'widget-emplois',   label: 'Emplois',             group: 'Économie' },
    { id: 'widget-internet',  label: 'Internet',            group: 'Économie' },
  ];

  function loadPrefs() {
    try { return JSON.parse(localStorage.getItem(PREFS_KEY)) || {}; } catch { return {}; }
  }

  function savePrefs(prefs) {
    localStorage.setItem(PREFS_KEY, JSON.stringify(prefs));
  }

  function applyPrefs() {
    const prefs = loadPrefs();
    for (const w of WIDGET_REGISTRY) {
      const el = document.getElementById(w.id);
      if (!el) continue;
      const visible = prefs[w.id] !== false;
      el.style.display = visible ? '' : 'none';
    }
    // Reflow : ajuster le nombre de colonnes pour densifier la grille.
    document.querySelectorAll('.widget-grid').forEach(grid => {
      const children = [...grid.children].filter(c => c.id?.startsWith('widget-'));
      if (children.length === 0) return;
      const visibleChildren = children.filter(c => c.style.display !== 'none');
      const visibleCount = visibleChildren.length;
      // Compte pondéré qui tient compte des widgets avec col-span (data-col-span)
      const visibleWeight = visibleChildren.reduce((sum, c) => sum + (parseInt(c.dataset.colSpan || '1', 10)), 0);
      if (visibleCount === 0) {
        grid.style.display = 'none';
        return;
      }
      grid.style.display = '';
      const baseMax = parseInt(grid.dataset.colsBaseMax || '1', 10);
      const smMax   = parseInt(grid.dataset.colsSmMax   || String(baseMax), 10);
      const lgMax   = parseInt(grid.dataset.colsLgMax   || String(smMax), 10);
      grid.style.setProperty('--cols-base', Math.min(visibleWeight, baseMax));
      grid.style.setProperty('--cols-sm',   Math.min(visibleWeight, smMax));
      grid.style.setProperty('--cols-lg',   Math.min(visibleWeight, lgMax));
    });
  }

  function buildPrefsModal() {
    const list = document.getElementById('modal-prefs-list');
    const prefs = loadPrefs();
    const groups = {};
    for (const w of WIDGET_REGISTRY) {
      (groups[w.group] = groups[w.group] || []).push(w);
    }
    list.innerHTML = Object.entries(groups).map(([group, widgets]) => `
      <div class="mb-3">
        <div class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1.5 mt-2">${group}</div>
        ${widgets.map(w => {
          const checked = prefs[w.id] !== false;
          return `<label class="flex items-center justify-between py-2 px-3 rounded-lg hover:bg-gray-800/50 cursor-pointer transition-colors group">
            <span class="text-sm text-gray-200 group-hover:text-white transition-colors">${w.label}</span>
            <div class="relative">
              <input type="checkbox" data-widget="${w.id}" ${checked ? 'checked' : ''}
                class="sr-only peer" />
              <div class="w-9 h-5 bg-gray-700 rounded-full peer-checked:bg-cjeao transition-colors"></div>
              <div class="absolute top-0.5 left-0.5 w-4 h-4 bg-white rounded-full shadow transition-transform peer-checked:translate-x-4"></div>
            </div>
          </label>`;
        }).join('')}
      </div>
    `).join('');
  }

  // Ouvrir / fermer le modal
  const modal = document.getElementById('modal-prefs');
  const btnOpen = document.getElementById('btn-personnaliser');
  const btnClose = document.getElementById('modal-prefs-close');
  const btnDone = document.getElementById('modal-prefs-done');
  const btnReset = document.getElementById('modal-prefs-reset');
  const backdrop = document.getElementById('modal-prefs-backdrop');

  function openPrefsModal() {
    buildPrefsModal();
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }
  function closePrefsModal() {
    modal.classList.add('hidden');
    document.body.style.overflow = '';
  }

  btnOpen.addEventListener('click', openPrefsModal);
  btnClose.addEventListener('click', closePrefsModal);
  backdrop.addEventListener('click', closePrefsModal);
  btnDone.addEventListener('click', closePrefsModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) closePrefsModal();
  });

  // Sauvegarder en temps réel quand on toggle un switch
  document.getElementById('modal-prefs-list').addEventListener('change', (e) => {
    const cb = e.target;
    if (!cb.dataset.widget) return;
    const prefs = loadPrefs();
    prefs[cb.dataset.widget] = cb.checked;
    savePrefs(prefs);
    applyPrefs();
    updatePrefsIndicator();
  });

  // Réinitialiser
  btnReset.addEventListener('click', () => {
    localStorage.removeItem(PREFS_KEY);
    applyPrefs();
    updatePrefsIndicator();
    buildPrefsModal();
  });

  function updatePrefsIndicator() {
    const prefs = loadPrefs();
    const hiddenCount = WIDGET_REGISTRY.filter(w => prefs[w.id] === false).length;
    const indicator = document.getElementById('prefs-indicator');
    if (hiddenCount > 0) {
      if (!indicator) {
        const dot = document.createElement('span');
        dot.id = 'prefs-indicator';
        dot.className = 'absolute -top-1 -right-1 w-3.5 h-3.5 bg-cjeao text-dark text-[0.55rem] font-bold rounded-full flex items-center justify-center';
        dot.textContent = hiddenCount;
        btnOpen.style.position = 'relative';
        btnOpen.appendChild(dot);
      } else {
        indicator.textContent = hiddenCount;
      }
    } else if (indicator) {
      indicator.remove();
    }
  }

  // Appliquer les préférences au chargement
  applyPrefs();
  updatePrefsIndicator();

  // Afficher tout de suite la liste des sources (sans les counts)
  renderSources({}, {});
  chargerNouvelles();
  chargerCommentaires();

  // ─── Auto-refresh des widgets (kiosque + visiteurs) ───────────────────────────
  // Relit Supabase DIRECTEMENT (clé anon) → 0 invocation Netlify. Les widgets se
  // mettent à jour dès que les crons écrivent, sans rechargement de page.
  async function rafraichirNouvelles() {
    try {
      appliquerDonnees(await chargerDepuisSupabase());
    } catch (err) {
      // En cas d'échec, on garde les données déjà affichées (pas d'état d'erreur).
      console.warn('[nouvelles] auto-refresh ignoré:', err.message);
    }
  }
  // Toutes les 5 min, uniquement si l'onglet est visible.
  setInterval(() => { if (!document.hidden) rafraichirNouvelles(); }, 5 * 60 * 1000);
  // Rafraîchir aussi dès qu'on revient sur l'onglet après une absence.
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) rafraichirNouvelles();
  });
</script>
