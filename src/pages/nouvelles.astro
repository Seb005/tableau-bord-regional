---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';

const VAPID_PUBLIC_KEY = import.meta.env.PUBLIC_VAPID_PUBLIC_KEY || '';
const SITE_URL = import.meta.env.PUBLIC_SITE_URL || Astro.url.origin;
const SHARE_URL = encodeURIComponent(`${SITE_URL}/nouvelles`);
const SHARE_TEXT = encodeURIComponent(`Tableau de bord de ${site.region}`);

const pageDescription = `Tableau de bord régional de ${site.region} : météo, essence, urgences, routes, pannes, alertes et nouvelles agrégées de sources locales.`;
---

<BaseLayout
  title="Nouvelles"
  description={pageDescription}
  image="/images/og-nouvelles.png"
>

  <!-- En-tête fusionné dans la section widgets pour gagner ~30px verticaux -->
  <section class="bg-dark pt-16 pb-8 lg:pt-18 lg:pb-10 grain">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Barre titre + horloge -->
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 mb-3 text-white">
        <div class="flex items-baseline gap-2">
          <h1 class="text-3xl lg:text-5xl font-extrabold tracking-tight">Nouvelles</h1>
          <span class="text-[0.65rem] font-bold uppercase tracking-wider text-cjeao">Tableau de bord</span>
        </div>
        <div class="flex items-center gap-3">
          <button id="btn-personnaliser" type="button" class="inline-flex items-center gap-1.5 px-3 py-2 bg-gray-800 text-gray-300 text-xs font-semibold rounded-lg border border-gray-600 hover:bg-gray-700 hover:text-white transition-all min-h-[40px]">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><circle cx="12" cy="12" r="3"/></svg>
            <span class="hidden sm:inline">Personnaliser</span>
          </button>
          <button id="btn-installer" type="button" class="hidden items-center gap-1.5 px-2 py-0.5 bg-cjeao text-dark text-xs font-bold rounded hover:shadow-[0_0_12px_rgba(0,255,110,0.4)] transition-all">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16"/></svg>
            Installer
          </button>
          <button id="btn-alertes" type="button" class="hidden items-center gap-1.5 px-2 py-0.5 bg-amber-500 text-dark text-xs font-bold rounded hover:shadow-[0_0_12px_rgba(245,158,11,0.5)] transition-all" title="Activer les alertes urgentes (inondations, fermetures, etc.)">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
            Alertes
          </button>
          <div class="flex items-baseline gap-2 text-xs lg:text-sm">
            <span id="date-aujourdhui" class="text-gray-200 capitalize">…</span>
            <span class="text-gray-500">·</span>
            <span id="heure-aujourdhui" class="text-cjeao font-mono font-semibold tabular-nums">--:--</span>
            <span id="visiteurs-bloc" class="hidden items-center gap-1.5 text-gray-300 ml-2 pl-2 border-l border-gray-700" title="Visiteurs en ligne en ce moment (Plausible)">
              <span class="inline-block w-1.5 h-1.5 bg-cjeao rounded-full" style="box-shadow: 0 0 6px #00FF6E; animation: visiteurs-pulse 2s ease-in-out infinite;"></span>
              <span id="visiteurs-nombre" class="text-cjeao font-semibold tabular-nums">—</span>
              <span class="text-gray-400 hidden sm:inline">en ligne</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Bannière transport scolaire (visible seulement en cas d'alerte) -->
      <div id="widget-transport" class="hidden mb-3"></div>

      <!-- Row 1: 4 widgets "lourds" -->
      <div class="widget-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-3" data-cols-sm-max="2" data-cols-lg-max="4">
        <div id="widget-meteo" class="border border-gray-700 rounded-xl p-3.5 flex flex-col gap-1.5">
          <div class="animate-pulse space-y-3"><div class="h-4 w-20 bg-gray-700 rounded"></div><div class="h-10 w-24 bg-gray-700 rounded"></div><div class="h-3 w-full bg-gray-700 rounded"></div><div class="h-3 w-2/3 bg-gray-700 rounded"></div></div>
        </div>
        <div id="widget-essence" class="border border-gray-700 rounded-xl p-3.5 flex flex-col gap-1.5">
          <div class="animate-pulse space-y-3"><div class="h-4 w-20 bg-gray-700 rounded"></div><div class="h-10 w-24 bg-gray-700 rounded"></div><div class="h-3 w-full bg-gray-700 rounded"></div><div class="h-3 w-2/3 bg-gray-700 rounded"></div></div>
        </div>
        <div id="widget-finances" class="border border-gray-700 rounded-xl p-3.5 flex flex-col gap-1.5">
          <div class="animate-pulse space-y-3"><div class="h-4 w-20 bg-gray-700 rounded"></div><div class="h-10 w-24 bg-gray-700 rounded"></div><div class="h-3 w-full bg-gray-700 rounded"></div><div class="h-3 w-2/3 bg-gray-700 rounded"></div></div>
        </div>
        <div id="widget-urgences" class="border border-gray-700 rounded-xl p-3.5 flex flex-col gap-1.5">
          <div class="animate-pulse space-y-3"><div class="h-4 w-24 bg-gray-700 rounded"></div><div class="h-3 w-full bg-gray-700 rounded"></div><div class="h-3 w-5/6 bg-gray-700 rounded"></div><div class="h-3 w-3/4 bg-gray-700 rounded"></div></div>
        </div>
      </div>

      <!-- Mini-row : 6 widgets compacts (statut en un coup d'œil) -->
      <div class="widget-grid grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-3" data-cols-base-max="2" data-cols-sm-max="3" data-cols-lg-max="6">
        <div id="widget-sopfeu" class="widget-mini border border-gray-700 rounded-lg p-2.5 flex flex-col gap-0.5">
          <div class="animate-pulse space-y-2"><div class="h-3 w-16 bg-gray-700 rounded"></div><div class="h-6 w-20 bg-gray-700 rounded"></div></div>
        </div>
        <div id="widget-alertes" class="widget-mini border border-gray-700 rounded-lg p-2.5 flex flex-col gap-0.5">
          <div class="animate-pulse space-y-2"><div class="h-3 w-20 bg-gray-700 rounded"></div><div class="h-6 w-24 bg-gray-700 rounded"></div></div>
        </div>
        <div id="widget-hydro" class="widget-mini border border-gray-700 rounded-lg p-2.5 flex flex-col gap-0.5">
          <div class="animate-pulse space-y-2"><div class="h-3 w-20 bg-gray-700 rounded"></div><div class="h-6 w-24 bg-gray-700 rounded"></div></div>
        </div>
        <div id="widget-bornes" class="widget-mini border border-gray-700 rounded-lg p-2.5 flex flex-col gap-0.5">
          <div class="animate-pulse space-y-2"><div class="h-3 w-20 bg-gray-700 rounded"></div><div class="h-6 w-20 bg-gray-700 rounded"></div></div>
        </div>
        <div id="widget-air" class="widget-mini border border-gray-700 rounded-lg p-2.5 flex flex-col gap-0.5">
          <div class="animate-pulse space-y-2"><div class="h-3 w-16 bg-gray-700 rounded"></div><div class="h-6 w-16 bg-gray-700 rounded"></div></div>
        </div>
        <div id="widget-devises" class="widget-mini border border-gray-700 rounded-lg p-2.5 flex flex-col gap-0.5">
          <div class="animate-pulse space-y-2"><div class="h-3 w-16 bg-gray-700 rounded"></div><div class="h-3 w-20 bg-gray-700 rounded"></div><div class="h-3 w-20 bg-gray-700 rounded"></div></div>
        </div>
      </div>

      <!-- Row 3: 4 widgets "medium" -->
      <div class="widget-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-3" data-cols-sm-max="2" data-cols-lg-max="4">
        <div id="widget-routes" class="border border-gray-700 rounded-xl p-3.5 flex flex-col gap-1.5">
          <div class="animate-pulse space-y-3"><div class="h-4 w-24 bg-gray-700 rounded"></div><div class="h-3 w-full bg-gray-700 rounded"></div><div class="h-3 w-5/6 bg-gray-700 rounded"></div><div class="h-3 w-3/4 bg-gray-700 rounded"></div></div>
        </div>
        <div id="widget-aurores" class="border border-gray-700 rounded-xl p-3.5 flex flex-col gap-1.5">
          <div class="animate-pulse space-y-3"><div class="h-4 w-32 bg-gray-700 rounded"></div><div class="h-8 w-24 bg-gray-700 rounded"></div><div class="h-3 w-3/4 bg-gray-700 rounded"></div></div>
        </div>
        <div id="widget-eau" class="border border-gray-700 rounded-xl p-3.5 flex flex-col gap-1.5">
          <div class="animate-pulse space-y-3"><div class="h-4 w-28 bg-gray-700 rounded"></div><div class="h-3 w-full bg-gray-700 rounded"></div><div class="h-3 w-5/6 bg-gray-700 rounded"></div></div>
        </div>
        <div id="widget-internet" class="border border-gray-700 rounded-xl p-3.5 flex flex-col gap-1.5">
          <div class="animate-pulse space-y-3"><div class="h-4 w-36 bg-gray-700 rounded"></div><div class="h-8 w-24 bg-gray-700 rounded"></div><div class="h-3 w-full bg-gray-700 rounded"></div></div>
        </div>
      </div>

      <!-- Row Agenda : pleine largeur, mis en valeur (Loisirs + CCIAO + Carrefour) -->
      <div class="widget-grid grid grid-cols-1 gap-4 mb-3" data-cols-lg-max="1">
        <div id="widget-loisirs" class="border border-gray-700 rounded-xl p-4 sm:p-5 flex flex-col gap-2">
          <div class="animate-pulse space-y-3"><div class="h-4 w-40 bg-gray-700 rounded"></div><div class="grid grid-cols-1 sm:grid-cols-2 gap-2"><div class="h-3 w-full bg-gray-700 rounded"></div><div class="h-3 w-full bg-gray-700 rounded"></div><div class="h-3 w-5/6 bg-gray-700 rounded"></div><div class="h-3 w-5/6 bg-gray-700 rounded"></div></div></div>
        </div>
      </div>

      <!-- Banner: Emplois (redesigned) -->
      <div id="widget-emplois" class="border border-cjeao/30 bg-gradient-to-br from-cjeao/10 to-transparent rounded-xl p-4 sm:p-5 flex flex-col gap-3">
        <div class="animate-pulse space-y-3"><div class="h-4 w-32 bg-gray-700 rounded"></div><div class="h-8 w-48 bg-gray-700 rounded"></div><div class="h-3 w-full bg-gray-700 rounded"></div></div>
      </div>

    </div>

    <!-- Modal Personnaliser -->
    <div id="modal-prefs" class="fixed inset-0 z-50 hidden">
      <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" id="modal-prefs-backdrop"></div>
      <div class="relative flex items-center justify-center min-h-full p-4">
        <div class="bg-gray-900 border border-gray-700 rounded-2xl shadow-2xl w-full max-w-lg max-h-[80vh] overflow-y-auto">
          <div class="sticky top-0 bg-gray-900 border-b border-gray-700 px-5 py-3.5 flex items-center justify-between rounded-t-2xl z-10">
            <div>
              <h3 class="text-lg font-bold text-white">Personnaliser le tableau de bord</h3>
              <p class="text-xs text-gray-400 mt-0.5">Choisissez les widgets à afficher</p>
            </div>
            <button id="modal-prefs-close" class="text-gray-400 hover:text-white transition-colors p-1">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>
          <div id="modal-prefs-list" class="px-5 py-3 space-y-1"></div>
          <div class="sticky bottom-0 bg-gray-900 border-t border-gray-700 px-5 py-3 flex items-center justify-between rounded-b-2xl">
            <button id="modal-prefs-reset" class="text-xs text-gray-400 hover:text-cjeao transition-colors">Tout réafficher</button>
            <button id="modal-prefs-done" class="px-4 py-1.5 bg-cjeao text-dark text-sm font-bold rounded-lg hover:shadow-[0_0_12px_rgba(0,255,110,0.3)] transition-all">Terminé</button>
          </div>
        </div>
      </div>
    </div>

  </section>

  <!-- Articles section -->
  <section class="bg-cream py-12 lg:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="flex flex-wrap items-baseline justify-between gap-3 mb-6">
        <div class="flex items-baseline gap-3 flex-wrap">
          <h2 class="text-2xl lg:text-3xl font-extrabold text-gray-900 tracking-tight">Actualités régionales</h2>
          <label class="inline-flex items-center gap-2 text-xs text-gray-600 cursor-pointer select-none">
            <input id="filtre-ao" type="checkbox" checked class="accent-cjeao-darker w-3.5 h-3.5" />
            <span>Filtre {site.region}</span>
            <span id="filtre-info" class="text-gray-400"></span>
          </label>
        </div>
        <div class="flex items-center gap-2 text-sm text-gray-400">
          <span class="text-xs uppercase tracking-wider hidden sm:inline">Partager</span>
          <a href={`https://twitter.com/intent/tweet?text=${SHARE_TEXT}&url=${SHARE_URL}`}
             target="_blank" rel="noopener noreferrer" aria-label="Partager sur X (Twitter)" title="Partager sur X (Twitter)"
             class="w-9 h-9 inline-flex items-center justify-center text-gray-400 hover:text-gray-900 hover:bg-gray-100 rounded transition-colors">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${SHARE_URL}`}
             target="_blank" rel="noopener noreferrer" aria-label="Partager sur LinkedIn" title="Partager sur LinkedIn"
             class="w-9 h-9 inline-flex items-center justify-center text-gray-400 hover:text-[#0a66c2] hover:bg-gray-100 rounded transition-colors">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.778 13.019H3.555V9h3.56v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href={`https://www.facebook.com/sharer/sharer.php?u=${SHARE_URL}`}
             target="_blank" rel="noopener noreferrer" aria-label="Partager sur Facebook" title="Partager sur Facebook"
             class="w-9 h-9 inline-flex items-center justify-center text-gray-400 hover:text-[#1877f2] hover:bg-gray-100 rounded transition-colors">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href={`mailto:?subject=${SHARE_TEXT}&body=${SHARE_URL}`}
             aria-label="Partager par courriel" title="Partager par courriel"
             class="w-9 h-9 inline-flex items-center justify-center text-gray-400 hover:text-gray-900 hover:bg-gray-100 rounded transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </a>
          <span class="text-gray-300 mx-1">·</span>
          <a href="/nouvelles/archives" class="text-xs text-gray-500 hover:text-cjeao-darker hover:underline">Archives</a>
          <a href="/nouvelles/wallpaper" target="_blank" rel="noopener" class="text-xs text-gray-500 hover:text-cjeao-darker hover:underline" title="Version optimisée pour fond d'écran">Wallpaper</a>
        </div>
      </div>

      <ul id="articles-list" class="divide-y divide-gray-200 bg-white rounded-xl border border-gray-200 px-3">
        {/* Skeletons */}
        {Array.from({ length: 6 }).map(() => (
          <li class="animate-pulse py-3 space-y-2">
            <div class="flex items-center justify-between">
              <div class="h-5 w-24 bg-gray-200 rounded"></div>
              <div class="h-3 w-16 bg-gray-200 rounded"></div>
            </div>
            <div class="h-4 w-full bg-gray-200 rounded"></div>
            <div class="h-3 w-2/3 bg-gray-200 rounded"></div>
          </li>
        ))}
      </ul>

    </div>
  </section>

  <!-- Mini-forum / Suggestions -->
  <section class="bg-white py-10 lg:py-14 border-t border-gray-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8">

        <!-- Formulaire -->
        <div class="lg:col-span-2">
          <h2 class="text-xl lg:text-2xl font-extrabold text-gray-900 tracking-tight">Suggérer une source</h2>
          <p class="text-sm text-gray-600 mt-1 mb-5">Une source à ajouter? Une réaction? Dites-nous tout.</p>

          <form id="form-commentaire" class="space-y-3" novalidate>
            <div>
              <label for="c-nom" class="block text-sm font-semibold text-gray-700 mb-1">Nom <span class="text-red-500">*</span></label>
              <input id="c-nom" name="nom" type="text" maxlength="80" required
                class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:border-cjeao focus:ring-1 focus:ring-cjeao outline-none" />
            </div>
            <div>
              <label for="c-courriel" class="block text-sm font-semibold text-gray-700 mb-1">Courriel <span class="text-gray-400">(optionnel)</span></label>
              <input id="c-courriel" name="courriel" type="email" maxlength="200"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:border-cjeao focus:ring-1 focus:ring-cjeao outline-none" />
              <p class="text-xs text-gray-500 mt-1">Pour qu'on puisse vous répondre. Non affiché publiquement.</p>
            </div>
            <div>
              <label for="c-message" class="block text-sm font-semibold text-gray-700 mb-1">Message <span class="text-red-500">*</span></label>
              <textarea id="c-message" name="message" rows="4" maxlength="1500" required
                class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:border-cjeao focus:ring-1 focus:ring-cjeao outline-none resize-y"></textarea>
            </div>
            {/* Honeypot anti-spam, caché aux humains */}
            <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute -left-[9999px] w-px h-px opacity-0" />
            <div class="flex items-center gap-3">
              <button type="submit" class="px-4 py-2 bg-cjeao text-dark font-semibold rounded-lg hover:shadow-[0_0_20px_rgba(0,255,110,0.3)] transition-all text-sm">
                Envoyer
              </button>
              <span id="c-status" class="text-sm" aria-live="polite"></span>
            </div>
          </form>
        </div>

        <!-- Liste des commentaires publiés -->
        <div class="lg:col-span-3">
          <h2 class="text-xl lg:text-2xl font-extrabold text-gray-900 tracking-tight">Suggestions de la communauté</h2>
          <p class="text-sm text-gray-600 mt-1 mb-5">Ce que la communauté nous a partagé récemment. <a href="/nouvelles/methodologie" class="text-cjeao-darker hover:underline">Comprendre notre démarche →</a></p>

          <ul id="commentaires-list" class="divide-y divide-gray-200 bg-gray-50 rounded-xl border border-gray-200">
            <li class="animate-pulse py-3 px-4">
              <div class="h-4 w-24 bg-gray-200 rounded mb-2"></div>
              <div class="h-3 w-full bg-gray-200 rounded mb-1"></div>
              <div class="h-3 w-3/4 bg-gray-200 rounded"></div>
            </li>
            <li class="animate-pulse py-3 px-4">
              <div class="h-4 w-32 bg-gray-200 rounded mb-2"></div>
              <div class="h-3 w-full bg-gray-200 rounded"></div>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- Sources surveillées -->
  <section class="bg-gray-100 py-10 lg:py-14 border-t border-gray-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="mb-5 flex flex-wrap items-baseline justify-between gap-3">
        <div>
          <h2 class="text-xl lg:text-2xl font-extrabold text-gray-900 tracking-tight">Sources surveillées</h2>
          <p class="text-sm text-gray-600 mt-1">Les flux que nous consultons pour cette page. Si une source ne publie pas, elle reste tout de même dans la boucle.</p>
        </div>
        <a href="/nouvelles/methodologie" class="text-sm text-cjeao-darker hover:underline shrink-0">Comment on récolte l'information →</a>
      </div>

      <div id="sources-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3"></div>

      <p class="text-xs text-gray-500 mt-6 text-center">
