# ============================================================================
# Tableau de bord régional — Variables d'environnement
# ============================================================================
# Copier ce fichier en `.env` pour le développement local :
#   cp .env.example .env
#
# En production (Netlify), définir ces variables dans :
#   Site settings → Build & deploy → Environment variables
# ============================================================================

# ----------------------------------------------------------------------------
# OBLIGATOIRES
# ----------------------------------------------------------------------------

# Supabase — projet Postgres + Auth. Créez un projet sur https://supabase.com
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx   # SECRET (service_role) — JAMAIS exposée au client
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx      # publique (read-only via RLS)
PUBLIC_SUPABASE_URL=${SUPABASE_URL}
PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# URL publique du site (pour Open Graph, sitemap, partages)
PUBLIC_SITE_URL=https://votre-domaine.com

# CORS — liste CSV des origines autorisées à appeler les Netlify Functions
ALLOWED_ORIGINS=https://votre-domaine.com,https://votre-site.netlify.app

# ----------------------------------------------------------------------------
# NOTIFICATIONS PUSH (recommandé)
# ----------------------------------------------------------------------------
# Générer une paire de clés VAPID avec :
#   npx web-push generate-vapid-keys

VAPID_PUBLIC_KEY=Bxxxxx
VAPID_PRIVATE_KEY=xxxxx   # SECRET
PUBLIC_VAPID_PUBLIC_KEY=${VAPID_PUBLIC_KEY}
VAPID_SUBJECT=mailto:contact@votre-domaine.com
PUSH_ADMIN_TOKEN=changez-moi-pour-un-secret-aleatoire   # autorise l'envoi par push-envoyer

# ----------------------------------------------------------------------------
# WIDGET EMPLOIS (optionnel)
# ----------------------------------------------------------------------------
# URL d'un portail Jobstat à scraper. Si vide, le widget reste vide.
JOBS_PORTAL_URL=
JOBS_USER_AGENT=

# ----------------------------------------------------------------------------
# WIDGET INTERNET / M-Lab BigQuery (optionnel)
# ----------------------------------------------------------------------------
# JSON stringifié du compte de service Google Cloud (BigQuery Reader).
# Si non défini, le widget Internet est désactivé.
GCP_CREDENTIALS_JSON=

# ----------------------------------------------------------------------------
# MONITORING — Sentry (optionnel)
# ----------------------------------------------------------------------------
# DSN client Sentry. Public par design. Sans valeur, Sentry est désactivé.
PUBLIC_SENTRY_DSN=

# ----------------------------------------------------------------------------
# ANALYTICS (optionnel — tout est désactivé par défaut)
# ----------------------------------------------------------------------------
# Plausible — analytics privacy-friendly
PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=
PUBLIC_PLAUSIBLE_SCRIPT_URL=

# Google Analytics 4
PUBLIC_GA4_ID=

# Meta (Facebook) Pixel
PUBLIC_FB_PIXEL_ID=
PUBLIC_FB_APP_ID=

# Google Search Console verification
PUBLIC_GOOGLE_SITE_VERIFICATION=

# URL de votre politique de confidentialité (affichée dans la bannière cookies)
PUBLIC_PRIVACY_URL=

# ----------------------------------------------------------------------------
# HEALTH-CHECK (optionnel)
# ----------------------------------------------------------------------------
# Surveillance automatique du tableau de bord (toutes les 30 min) + alertes
# par courriel via Resend (https://resend.com).
RESEND_API_KEY=
FROM_EMAIL="Tableau de bord <alerts@votre-domaine.com>"
ALERT_EMAIL=admin@votre-domaine.com
SITE_URL=${PUBLIC_SITE_URL}
